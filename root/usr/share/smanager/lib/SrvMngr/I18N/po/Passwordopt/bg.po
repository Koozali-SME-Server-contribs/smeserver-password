msgid "pdo_Password_strength_interm"
msgstr "(en) the password requires to pass a Cracklib dictionary check on top of the normal setting checks."

msgid "pdo_Password_strength_none"
msgstr "(en) the password can be anything as no checking is done other than the minimum length %1 of characters."

msgid "pdo_Password_strength_normal"
msgstr "(en) the password requires at least 1 upper (A-Z), 1 lower (a-z) on top of the none setting checks."

msgid "pdo_Password_strength_strong"
msgstr "(en) the password requires to have at least 1 digit (0-9) and 1 special character (/-?) on top of the intermediate setting checks."

