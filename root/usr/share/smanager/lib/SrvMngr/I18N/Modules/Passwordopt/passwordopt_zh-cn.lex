'pdo_Password_(advanced)' => '密码 (高级)',
'pdo_You_can_set_password_strength' => '您可以设置密码长度和时效',
'pdo_PASSWORD_AGEING_DESC' => '<![CDATA[ <h2>Password aging</h2> To enable aging set Activate password aging to Yes, then select each user you want aging enabled for. <br>Setting Activate password aging to No disables aging check for all users, but keep your user settings in case you activate the aging back. <br>This can be done for locked or passwordless accounts too. <br><strong>Note:</strong> Password aging doesn\'t apply to admin account<br> ]]>',
'pdo_PASSWORD_STRENGTH_DESC' => '<![CDATA[ <h2>Password strength</h2> Password strength can be set from \'None\' to \'Strong\' <ul> <li>Strong - Must pass all default cracklib tests and all "normal" tests.</li> <li>Normal - Must have at least 1 digit (0-9), 1 upper ([A-Z]), 1 lower ([a-z]), 1 special char (/-?) and be longer than 6 characters.</li> <li>None - no password checking</li> </ul> <strong>Note:</strong> Change of password strength value doesn\'t affect currently stored passwords<br> ]]>',
'pdo_PASSWORD_HISTORY_DESC' => '<![CDATA[ <h2>Password history</h2> Password history prevents users from reusing passwords (select 0 to disable) ]]>',
'pdo_Number_of_unique_passwords_to' => 'Number of unique passwords to remember',
'pdo_Activate_password_aging' => '激活“密码时效”',
'pdo_Number_of_days_during_which' => '密码有效的天数',
'pdo_Number_of_days_of_warning' => '必须更改密码前的警告天数',
'pdo_Admin' => '管理员密码',
'pdo_Ibays' => '信息港密码',
'pdo_Users' => '用户密码',
