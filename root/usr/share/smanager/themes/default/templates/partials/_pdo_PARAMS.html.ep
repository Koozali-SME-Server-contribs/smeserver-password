%#
%# Generated by SM2Gen version:0.9(20Jan2025) Chameleon version:4.5.4 On Python:3.12.3 at 2026-06-29 14:03:13 
%#
<div id="Passwordopt-PARAMS" class="partial Passwordopt-PARAMS">
	% if (config->{debug} == 1) {
		<pre>
			%= dumper $pdo_data
		</pre>
	% }
	% my $btn = l('pdo_Save');
	% $c->param(Selected => undef); #This may need deleting for a params panel - only needed for a table

	%= form_for "passwordoptu" => (method => 'POST') => begin
		% param 'trt' => $pdo_data->{trt} unless param 'trt';
		%= hidden_field 'trt' => $pdo_data->{trt}
		%# Inputs etc in here.

<!--		<h2 class='head'><%=l('pdo_Password_(advanced)')%></h2>-->
	
		<p class='paragraph para8'>
			%==l('pdo_If_you_want_to_know')
		</p>
	
		<p class='paragraph para1'>
			%=l('pdo_You_can_set_password_strength')
		</p>
	
		<h3 class='subh1'><%=l('pdo_Password_strength')%></h3>
	
		<p class='paragraph para1'>
			%==l('pdo_Password_strength_can_be_set')
			<ul><li>
			%=="<b>".l('pdo_Password_none')."</b>: ".l('pdo_Password_strength_none',l('pdo_default_length'))
			</li><li>
			%=="<b>".l('pdo_Password_normal')."</b>: ".l('pdo_Password_strength_normal')
                        </li><li>
                        %=="<b>".l('pdo_Password_intermediate')."</b>: ".l('pdo_Password_strength_interm')
                        </li><li>
                        %=="<b>".l('pdo_Password_strong')."</b>: ".l('pdo_Password_strength_strong')
			</li></ul>
		</p>
	
		<p><span class=label>
			%=l('pdo_Admin')
		</span><span class=data>
			% my @Admin_options = [[l('pdo_Password_strong') => 'strong'], [l('pdo_Password_intermediate') => 'intermediate'], [l('pdo_Password_normal') => 'normal'], [l('pdo_Password_none') => 'none']];
			% param 'Admin' => $pdo_data->{Admin} unless param 'Admin';
			%= select_field 'Admin' => @Admin_options, class => 'input', id => 'Admin_select'
		<br></span>	</p>
	
		<p><span class=label>
			%=l('pdo_Ibays')
		</span><span class=data>
			% my @Ibays_options = [['Strong' => 'strong'], ['Intermediate' => 'intermediate'], ['Normal' => 'normal'], ['None' => 'none']];
			% param 'Ibays' => $pdo_data->{Ibays} unless param 'Ibays';
			%= select_field 'Ibays' => @Ibays_options, class => 'input', id => 'Ibays_select'
		<br></span>	</p>
	
		<p><span class=label>
			%=l('pdo_Users')
		</span><span class=data>
			% my @Users_options = [['Strong' => 'strong'], ['Intermediate' => 'intermediate'], ['Normal' => 'normal'], ['None' => 'none']];
			% param 'Users' => $pdo_data->{Users} unless param 'Users';
			%= select_field 'Users' => @Users_options, class => 'input', id => 'Users_select'
		<br></span>	</p>
	
		<p class='paragraph para3'>
			%=l('pdo_And_password_minimum_length_(which',l('pdo_default_length'))
		</p>
	
		<p><span class='label'>
			%=l('pdo_Password_length_(min_of_6)')
		</span><span class=data>
			% param 'passwordlength' => $pdo_data->{passwordlength} unless param 'passwordlength';
			%=number_field 'passwordlength', class => 'numb', min =>6, placeholder => 'The default of 12 is optimal'
		</span></p>
		
	
		<h3 class='subh2'><%=l('pdo_Password_History')%></h3>
	
		<p class='paragraph para6'>
			%=l('pdo_Password_history_prevents_users_from')
		</p>
	
		<p><span class=label>
			%=l('pdo_Number_of_unique_passwords_to')
		</span><span class=data>
			% my @passwordhistory_options = [['0' => '0'], ['3' => '3'], ['5' => '5'], ['10' => '10'], ['20' => '20'], ['50' => '50'], ['100' => '100']];
			% param 'passwordhistory' => $pdo_data->{passwordhistory} unless param 'passwordhistory';
			%= select_field 'passwordhistory' => @passwordhistory_options, class => 'input', id => 'passwordhistory_select'
		<br></span>	</p>
	
		<h3 class='subh3'><%=l('pdo_Password_aging')%></h3>
	
		<p class='paragraph para2'>
			%==l('pdo_To_enable_aging_set_Activate')
		</p>
	
		<p><span class=label>
			%=l('pdo_Activate_password_aging')
		</span><span class=data>
			% my @Active_options = [['No' => 'no'], ['Yes' => 'yes']];
			% param 'Active' => $pdo_data->{Active} unless param 'Active';
			%= select_field 'Active' => @Active_options, class => 'input', id => 'Active_select'
		<br></span>	</p>
	
		<p><span class=label>
			%=l('pdo_Number_of_days_during_which')
		</span><span class=data>
			% my @PwdAge_options = [['30' => '30'], ['60' => '60'], ['90' => '90'], ['120' => '120'], ['180' => '180'], ['240' => '240'], ['365' => '365']];
			% param 'PwdAge' => $pdo_data->{PwdAge} unless param 'PwdAge';
			%= select_field 'PwdAge' => @PwdAge_options, class => 'input', id => 'PwdAge_select'
		<br></span>	</p>
	
		<p><span class=label>
			%=l('pdo_Number_of_days_of_warning')
		</span><span class=data>
			% my @PwdWarn_options = [['7' => '7'], ['10' => '10'], ['15' => '15']];
			% param 'PwdWarn' => $pdo_data->{PwdWarn} unless param 'PwdWarn';
			%= select_field 'PwdWarn' => @PwdWarn_options, class => 'input', id => 'PwdWarn_select'
		<br></span>	</p>
	
		<p><span class=label>
			%=l('pdo_Block_account_on_password_expiration?')
		</span><span class=data>
			% my @LockAccount_options = [['No' => 'no'], ['Yes' => 'yes']];
			% param 'LockAccount' => $pdo_data->{LockAccount} unless param 'LockAccount';
			%= select_field 'LockAccount' => @LockAccount_options, class => 'input', id => 'LockAccount_select'
		<br></span>	</p>
	
		<p><span class=label>
			%=l('pdo_Set_today_as_last_modification')
		</span><span class=data>
			% my @DateReset_options = [['No' => 'no'], ['Yes' => 'yes']];
			% param 'DateReset' => $pdo_data->{DateReset} unless param 'DateReset';
			%= select_field 'DateReset' => @DateReset_options, class => 'input', id => 'DateReset_select'
		<br></span>	</p>
	
		<h3 class='subh4'><%=l('pdo_Users_list')%></h3>
	
		<br /><table class="sme-border TableSort sme-table tabl1 ">
			<thead class='tabl1'>
				<tr table-head-row>
					<th class='sme-border table-head-col table-head-col-User '><%=l('pdo_User')%></th>
					<th class='sme-border table-head-col table-head-col-Fullname '><%=l('pdo_Fullname')%></th>
					<th class='sme-border table-head-col table-head-col-Aging? '><%=l('pdo_Aging?')%></th>
					<th class='sme-border table-head-col table-head-col-Last modified '><%=l('pdo_Last_modified')%></th>
					<th class='sme-border table-head-col table-head-col-Expire on '><%=l('pdo_Expire_on')%></th>
					<th class='sme-border table-head-col table-head-col-Modify '><%=l('pdo_Modify')%></th>
					<th class='sme-border table-head-col table-head-col-Note '><%=l('pdo_Note')%></th>
				</tr>
			</thead>
			<tbody class='tabl1'>
				% my $control_data = $c->stash('Table1');
				% foreach my $row (@$control_data) {
				<tr class='table-row'>
					<td class='sme-border table-col table-col-Table1_User'><%=$c->render_to_string(inline=>$row->{'Table1_User'})%></td>
					<td class='sme-border table-col table-col-Table1_Fullname'><%=$c->render_to_string(inline=>$row->{'Table1_Fullname'})%></td>
					<td class='sme-border table-col table-col-Table1_Aging?'><%=$c->render_to_string(inline=>$row->{'Table1_Aging?'})%></td>
					<td class='sme-border table-col table-col-Table1_Last modified'><%=$c->render_to_string(inline=>$row->{'Table1_Last modified'})%></td>
					<td class='sme-border table-col table-col-Table1_Expire on'><%=$c->render_to_string(inline=>$row->{'Table1_Expire on'})%></td>
					<td class="sme-border table-col table-col-Table1_EnableAgeing">
					  <input type="checkbox"
							 name="Table1_EnableAgeing"
							 value="<%= $row->{'Table1_EnableAgeingValue'} %>"
							 <%= $row->{'Table1_EnableAgeingChecked'} ? 'checked' : '' %>>
					</td>
					<td class='sme-border table-col table-col-Table1_Note'><%=$c->render_to_string(inline=>$row->{'Table1_Note'})%></td>		
				</tr>
				%}
			</tbody>
		</table>
		
		%# ....
		%# Probably finally by a submit.
		%= submit_button $btn, class => 'action'
	%end    
</div>
